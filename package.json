{
  "name": "hubspot-crm-mcp-server",
  "version": "0.1.0",
  "description": "An MCP server that connects Claude to a HubSpot CRM — search/create/update contacts, deals, and support tickets, plus a cross-object account summary tool.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hubspot-crm-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hubspot",
    "crm",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
